# -----------------------------------------------------------------------------
# JobPilot - Environment Variables Template
# Copy this file to .env.local and populate with your credentials
# -----------------------------------------------------------------------------

# InsForge Backend-as-a-Service (PostgreSQL, Auth, Storage)
NEXT_PUBLIC_INSFORGE_URL=https://your-app.region.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=your_insforge_anon_key_here

# OpenRouter / Gemini AI
# Used for AI Resume extraction, ATS generation, Job matching, and Company Research synthesis
OPENROUTER_API_KEY=your_openrouter_api_key_here
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Adzuna Developer API
# Sign up at https://developer.adzuna.com to get your App ID and App Key
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# Browserless.io
# Headless browser automation for Company Research agent
BROWSERLESS_API_KEY=your_browserless_api_key_here

# PostHog Product Analytics
# Sign up at https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_api_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# PostHog HogQL Analytics (Optional - Dashboard falls back to InsForge DB if omitted)
# Generate a Personal API Key in PostHog Settings -> Personal API Keys with Query permission
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
